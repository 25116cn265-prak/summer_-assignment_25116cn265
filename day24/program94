#include <stdio.h>
#include <string.h>

void compressString(const char *src, char *dest) {
    int i = 0;
    int j = 0;
    int len = strlen(src);

    // Handle empty string case
    if (len == 0) {
        dest[0] = '\0';
        return;
    }

    while (i < len) {
       
        dest[j++] = src[i];

        
        int count = 1;
        while (i + 1 < len && src[i] == src[i + 1]) {
            count++;
            i++;
        }

        
        j += sprintf(&dest[j], "%d", count);

        i++;
    }
    
    
    dest[j] = '\0';
}

int main() {
    char source[] = "AAAABBBCCCCCCDDDEFGHHHIJJJJ";
    
   
    char destination[sizeof(source) * 2]; 

    printf("Original String:   %s\n", source);
    
    compressString(source, destination);
    
    printf("Compressed String: %s\n", destination);

    return 0;
}
