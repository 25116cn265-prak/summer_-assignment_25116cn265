#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_WORDS 5
#define MAX_LENGTH 50


int compare_by_length(const void *a, const void *b) {
   
    const char *str1 = (const char *)a;
    const char *str2 = (const char *)b;
    
    size_t len1 = strlen(str1);
    size_t len2 = strlen(str2);
    
   
    if (len1 < len2) return -1;
    if (len1 > len2) return 1;
    
   
    return strcmp(str1, str2); 
}

int main() {
   
    char words[MAX_WORDS][MAX_LENGTH] = {
        "Elephant",
        "Cat",
        "Hippopotamus",
        "Dog",
        "Monkey"
    };

    printf("--- Original Words ---\n");
    for (int i = 0; i < MAX_WORDS; i++) {
        printf("%s\n", words[i]);
    }

   
    qsort(words, MAX_WORDS, MAX_LENGTH, compare_by_length);

    printf("\n--- Words Sorted by Length ---\n");
    for (int i = 0; i < MAX_WORDS; i++) {
        printf("%s (Length: %zu)\n", words[i], strlen(words[i]));
    }

    return 0;
}
