#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILE_NAME "contacts.txt"
#define MAX_NAME 50
#define MAX_PHONE 15
#define MAX_EMAIL 50


typedef struct {
    char name[MAX_NAME];
    char phone[MAX_PHONE];
    char email[MAX_EMAIL];
} Contact;


void addContact();
void listContacts();
void searchContact();
void editContact();
void deleteContact();
void clearInputBuffer();

int main() {
    int choice;

    while (1) {
        printf("\n=================================");
        printf("\n    CONTACT MANAGEMENT SYSTEM    ");
        printf("\n=================================");
        printf("\n1. Add New Contact");
        printf("\n2. List All Contacts");
        printf("\n3. Search Contact");
        printf("\n4. Edit Contact");
        printf("\n5. Delete Contact");
        printf("\n6. Exit");
        printf("\n=================================");
        printf("\nEnter your choice (1-6): ");
        
        if (scanf("%d", &choice) != 1) {
            printf("Invalid input! Please enter a number.\n");
            clearInputBuffer();
            continue;
        }
        clearInputBuffer();

        switch (choice) {
            case 1: addContact(); break;
            case 2: listContacts(); break;
            case 3: searchContact(); break;
            case 4: editContact(); break;
            case 5: deleteContact(); break;
            case 6: 
                printf("\nThank you for using the system. Goodbye!\n");
                exit(0);
            default: 
                printf("Invalid choice! Please select between 1 and 6.\n");
        }
    }
    return 0;
}


void clearInputBuffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

// 1. Add a New Contact
void addContact() {
    FILE *file = fopen(FILE_NAME, "a");
    if (file == NULL) {
        printf("Error opening file!\n");
        return;
    }

    Contact newContact;
    printf("\nEnter Name: ");
    fgets(newContact.name, MAX_NAME, stdin);
    newContact.name[strcspn(newContact.name, "\n")] = 0; 

    printf("Enter Phone Number: ");
    fgets(newContact.phone, MAX_PHONE, stdin);
    newContact.phone[strcspn(newContact.phone, "\n")] = 0;

    printf("Enter Email Address: ");
    fgets(newContact.email, MAX_EMAIL, stdin);
    newContact.email[strcspn(newContact.email, "\n")] = 0;

   
    fprintf(file, "%s\n%s\n%s\n", newContact.name, newContact.phone, newContact.email);
    fclose(file);

    printf("\nContact successfully added!\n");
}


void listContacts() {
    FILE *file = fopen(FILE_NAME, "r");
    if (file == NULL) {
        printf("\nNo contacts found. Create one first!\n");
        return;
    }

    Contact current;
    int count = 1;
    printf("\n%-5s %-25s %-15s %-25s", "S.No", "Name", "Phone", "Email");
    printf("\n------------------------------------------------------------------------");

   
    while (fgets(current.name, MAX_NAME, file)) {
        current.name[strcspn(current.name, "\n")] = 0;
        
        fgets(current.phone, MAX_PHONE, file);
        current.phone[strcspn(current.phone, "\n")] = 0;
        
        fgets(current.email, MAX_EMAIL, file);
        current.email[strcspn(current.email, "\n")] = 0;

        printf("\n%-5d %-25s %-15s %-25s", count++, current.name, current.phone, current.email);
    }
    printf("\n------------------------------------------------------------------------\n");
    fclose(file);
}


void searchContact() {
    FILE *file = fopen(FILE_NAME, "r");
    if (file == NULL) {
        printf("\nNo contacts found.\n");
        return;
    }

    char searchName[MAX_NAME];
    printf("\nEnter the name to search: ");
    fgets(searchName, MAX_NAME, stdin);
    searchName[strcspn(searchName, "\n")] = 0;

    Contact current;
    int found = 0;

    while (fgets(current.name, MAX_NAME, file)) {
        current.name[strcspn(current.name, "\n")] = 0;
        fgets(current.phone, MAX_PHONE, file);
        current.phone[strcspn(current.phone, "\n")] = 0;
        fgets(current.email, MAX_EMAIL, file);
        current.email[strcspn(current.email, "\n")] = 0;

       
        if (strstr(current.name, searchName) != NULL) {
            if (!found) {
                printf("\nMatch Found:");
                printf("\n-------------------------------------");
            }
            printf("\nName : %s", current.name);
            printf("\nPhone: %s", current.phone);
            printf("\nEmail: %s\n", current.email);
            found = 1;
        }
    }
    if (!found) {
        printf("\nNo contact matching '%s' was found.\n", searchName);
    }
    fclose(file);
}


void editContact() {
    FILE *file = fopen(FILE_NAME, "r");
    if (file == NULL) {
        printf("\nNo contacts found.\n");
        return;
    }

    char targetName[MAX_NAME];
    printf("\nEnter the name of the contact you want to edit: ");
    fgets(targetName, MAX_NAME, stdin);
    targetName[strcspn(targetName, "\n")] = 0;

  
    FILE *tempFile = fopen("temp.txt", "w");
    Contact current;
    int found = 0;

    while (fgets(current.name, MAX_NAME, file)) {
        current.name[strcspn(current.name, "\n")] = 0;
        fgets(current.phone, MAX_PHONE, file);
        current.phone[strcspn(current.phone, "\n")] = 0;
        fgets(current.email, MAX_EMAIL, file);
        current.email[strcspn(current.email, "\n")] = 0;

        if (strcmp(current.name, targetName) == 0) {
            found = 1;
            printf("\nEnter new details for %s:\n", targetName);
            
            printf("New Name: ");
            fgets(current.name, MAX_NAME, stdin);
            current.name[strcspn(current.name, "\n")] = 0;

            printf("New Phone Number: ");
            fgets(current.phone, MAX_PHONE, stdin);
            current.phone[strcspn(current.phone, "\n")] = 0;

            printf("New Email Address: ");
            fgets(current.email, MAX_EMAIL, stdin);
            current.email[strcspn(current.email, "\n")] = 0;
        }
        fprintf(tempFile, "%s\n%s\n%s\n", current.name, current.phone, current.email);
    }

    fclose(file);
    fclose(tempFile);

    if (found) {
        remove(FILE_NAME);
        rename("temp.txt", FILE_NAME);
        printf("\nContact updated successfully!\n");
    } else {
        remove("temp.txt");
        printf("\nContact not found.\n");
    }
}


void deleteContact() {
    FILE *file = fopen(FILE_NAME, "r");
    if (file == NULL) {
        printf("\nNo contacts found.\n");
        return;
    }

    char targetName[MAX_NAME];
    printf("\nEnter the name of the contact to delete: ");
    fgets(targetName, MAX_NAME, stdin);
    targetName[strcspn(targetName, "\n")] = 0;

    FILE *tempFile = fopen("temp.txt", "w");
    Contact current;
    int found = 0;

    while (fgets(current.name, MAX_NAME, file)) {
        current.name[strcspn(current.name, "\n")] = 0;
        fgets(current.phone, MAX_PHONE, file);
        current.phone[strcspn(current.phone, "\n")] = 0;
        fgets(current.email, MAX_EMAIL, file);
        current.email[strcspn(current.email, "\n")] = 0;

        if (strcmp(current.name, targetName) == 0) {
            found = 1;
            continue;
        }
        fprintf(tempFile, "%s\n%s\n%s\n", current.name, current.phone, current.email);
    }

    fclose(file);
    fclose(tempFile);

    if (found) {
        remove(FILE_NAME);
        rename("temp.txt", FILE_NAME);
        printf("\nContact deleted successfully!\n");
    } else {
        remove("temp.txt");
        printf("\nContact not found.\n");
    }
}
