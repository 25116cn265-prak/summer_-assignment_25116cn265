#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define TOTAL_SEATS 50
#define TICKET_PRICE 12.00  // Ticket cost in Dollars


typedef struct {
    int seatNumber;
    char passengerName[50];
    int isBooked; // 0 = Available, 1 = Booked
} Ticket;


void initializeSeats(Ticket system[], int size);
void displaySeats(Ticket system[], int size);
void bookTicket(Ticket system[], int size);
void cancelTicket(Ticket system[], int size);
void displayStats(Ticket system[], int size);

int main() {
    Ticket bookingSystem[TOTAL_SEATS];
    int choice;

   
    initializeSeats(bookingSystem, TOTAL_SEATS);

    while (1) {
        printf("\n==================================\n");
        printf("    TICKET BOOKING SYSTEM (C)     \n");
        printf("==================================\n");
        printf("1. View Seating Layout\n");
        printf("2. Book a Ticket\n");
        printf("3. Cancel a Ticket\n");
        printf("4. View System Statistics\n");
        printf("5. Exit Application\n");
        printf("Enter your selection (1-5): ");
        
        if (scanf("%d", &choice) != 1) {
            printf("Invalid data input format. Exiting.\n");
            break;
        }

        switch (choice) {
            case 1:
                displaySeats(bookingSystem, TOTAL_SEATS);
                break;
            case 2:
                bookTicket(bookingSystem, TOTAL_SEATS);
                break;
            case 3:
                cancelTicket(bookingSystem, TOTAL_SEATS);
                break;
            case 4:
                displayStats(bookingSystem, TOTAL_SEATS);
                break;
            case 5:
                printf("Thank you for using the Ticket Booking System. Goodbye!\n");
                exit(0);
            default:
                printf("Error: Invalid choice option. Please select 1 to 5.\n");
        }
    }
    return 0;
}

void initializeSeats(Ticket system[], int size) {
    for (int i = 0; i < size; i++) {
        system[i].seatNumber = i + 1;
        system[i].isBooked = 0;
        strcpy(system[i].passengerName, "None");
    }
}


void displaySeats(Ticket system[], int size) {
    printf("\n------- SEATING ARRANGEMENT CHART -------\n");
    printf("[X] = Reserved / Occupied   [O] = Empty / Available\n\n");
    
    for (int i = 0; i < size; i++) {
        if (system[i].isBooked == 1) {
            printf("Seat %02d:[X]  ", system[i].seatNumber);
        } else {
            printf("Seat %02d:[O]  ", system[i].seatNumber);
        }
        
       
        if ((i + 1) % 5 == 0) {
            printf("\n");
        }
    }
    printf("------------------------------------------\n");
}

 
void bookTicket(Ticket system[], int size) {
    int seatNo;
    printf("\nEnter preferred seat number to reserve (1-%d): ", size);
    scanf("%d", &seatNo);

    
    if (seatNo < 1 || seatNo > size) {
        printf("Execution Failed: Seat number does not exist.\n");
        return;
    }

   
    int index = seatNo - 1;

   
    if (system[index].isBooked == 1) {
        printf("Execution Failed: Seat %d is already reserved by %s.\n", seatNo, system[index].passengerName);
        return;
    }

   
    printf("Enter Passenger Full Name: ");
    char dummy; 
    scanf("%c", &dummy); // Clear standard input stream buffer newline character
    fgets(system[index].passengerName, 50, stdin);
    
  
    system[index].passengerName[strcspn(system[index].passengerName, "\n")] = '\0';

    system[index].isBooked = 1;

  
    printf("\n>>> TRANSACTION RECEIPT SUCCESSFUL <<<\n");
    printf("Passenger Name: %s\n", system[index].passengerName);
    printf("Assigned Seat : %d\n", system[index].seatNumber);
    printf("Base Ticket Fare: $%.2f\n", TICKET_PRICE);
    printf("Total Billing Charge: $%.2f (Paid)\n", TICKET_PRICE);
}


void cancelTicket(Ticket system[], int size) {
    int seatNo;
    printf("\nEnter seat number to drop cancellation (1-%d): ", size);
    scanf("%d", &seatNo);

    if (seatNo < 1 || seatNo > size) {
        printf("Execution Failed: Invalid seat validation index bounds.\n");
        return;
    }

    int index = seatNo - 1;

    if (system[index].isBooked == 0) {
        printf("Execution Failed: Seat %d is already entirely vacant.\n", seatNo);
        return;
    }

    printf("Success: Reservation for %s at seat %d has been canceled.\n", system[index].passengerName, seatNo);
    
 
    system[index].isBooked = 0;
    strcpy(system[index].passengerName, "None");
}


void displayStats(Ticket system[], int size) {
    int bookedCount = 0;
    for (int i = 0; i < size; i++) {
        if (system[i].isBooked == 1) {
            bookedCount++;
        }
    }

    int availableCount = size - bookedCount;
    double performanceRatio = ((double)bookedCount / size) * 100.00;
    double currentRevenue = bookedCount * TICKET_PRICE;

    printf("\n======= SYSTEM PERFORMANCE METRICS =======\n");
    printf("Total Operational Capacity : %d seats\n", size);
    printf("Total Confirmed Bookings   : %d seats\n", bookedCount);
    printf("Total Remaining Vacancies  : %d seats\n", availableCount);
    printf("Current Occupancy Load     : %.2f%%\n", performanceRatio);
    printf("Aggregated Sales Revenue   : $%.2f\n", currentRevenue);
    printf("==========================================\n");
}
