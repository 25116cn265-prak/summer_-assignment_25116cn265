#include <stdio.h>
#include <string.h>

#define MAX_ACCOUNTS 100


typedef struct {
    int accountNumber;
    char name[100];
    double balance;
} Account;


Account bank[MAX_ACCOUNTS];
int totalAccounts = 0;

// Function Prototypes
void createAccount();
void depositMoney();
void withdrawMoney();
void checkBalance();
void displayAllAccounts();
int findAccountIndex(int accNum);

int main() {
    int choice;

    
    do {
        printf("\n=== BANK ACCOUNT SYSTEM ===\n");
        printf("1. Create New Account\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Check Balance\n");
        printf("5. Display All Accounts\n");
        printf("6. Exit\n");
        printf("Enter your choice (1-6): ");
        
        // Read input configuration
        if (scanf("%d", &choice) != 1) {
            printf("Invalid input type. Exiting.\n");
            break;
        }

        switch (choice) {
            case 1:
                createAccount();
                break;
            case 2:
                depositMoney();
                break;
            case 3:
                withdrawMoney();
                break;
            case 4:
                checkBalance();
                break;
            case 5:
                displayAllAccounts();
                break;
            case 6:
                printf("Thank you for using our banking system!\n");
                break;
            default:
                printf("Invalid selection! Please choose between 1 and 6.\n");
        }
    } while (choice != 6);

    return 0;
}

// Function to safely create a new account
void createAccount() {
    if (totalAccounts >= MAX_ACCOUNTS) {
        printf("Bank capacity reached! Cannot create more accounts.\n");
        return;
    }

    int accNum;
    printf("\nEnter unique Account Number: ");
    scanf("%d", &accNum);

    // Validate if the account number already exists
    if (findAccountIndex(accNum) != -1) {
        printf("Error: An account with this number already exists!\n");
        return;
    }

    bank[totalAccounts].accountNumber = accNum;

    printf("Enter Account Holder Name: ");
    // Clear newline character from buffer before reading string
    scanf(" %[^\n]s", bank[totalAccounts].name); 

    printf("Enter Initial Deposit Amount: $");
    scanf("%lf", &bank[totalAccounts].balance);

    if (bank[totalAccounts].balance < 0) {
        printf("Error: Initial deposit cannot be negative.\n");
        return;
    }

    printf("Account created successfully for %s!\n", bank[totalAccounts].name);
    totalAccounts++;
}


void depositMoney() {
    int accNum;
    double amount;

    printf("\nEnter Account Number: ");
    scanf("%d", &accNum);

    int index = findAccountIndex(accNum);
    if (index == -1) {
        printf("Account not found!\n");
        return;
    }

    printf("Enter amount to deposit: $");
    scanf("%lf", &amount);

    if (amount <= 0) {
        printf("Invalid amount! Deposit must be greater than zero.\n");
        return;
    }

    bank[index].balance += amount;
    printf("Success! New Balance: $%.2f\n", bank[index].balance);
}


void withdrawMoney() {
    int accNum;
    double amount;

    printf("\nEnter Account Number: ");
    scanf("%d", &accNum);

    int index = findAccountIndex(accNum);
    if (index == -1) {
        printf("Account not found!\n");
        return;
    }

    printf("Enter amount to withdraw: $");
    scanf("%lf", &amount);

    if (amount <= 0) {
        printf("Invalid amount! Withdrawal must be greater than zero.\n");
        return;
    }

    if (amount > bank[index].balance) {
        printf("Transaction declined! Insufficient balance.\n");
        return;
    }

    bank[index].balance -= amount;
    printf("Success! Remaining Balance: $%.2f\n", bank[index].balance);
}


void checkBalance() {
    int accNum;

    printf("\nEnter Account Number: ");
    scanf("%d", &accNum);

    int index = findAccountIndex(accNum);
    if (index == -1) {
        printf("Account not found!\n");
        return;
    }

    printf("\nAccount Holder: %s\n", bank[index].name);
    printf("Current Balance: $%.2f\n", bank[index].balance);
}


void displayAllAccounts() {
    if (totalAccounts == 0) {
        printf("\nNo accounts registered in the system yet.\n");
        return;
    }

    printf("\n=========================================\n");
    printf("%-15s %-20s %-10s\n", "Acc Number", "Holder Name", "Balance");
    printf("=========================================\n");
    
    for (int i = 0; i < totalAccounts; i++) {
        printf("%-15d %-20s $%-10.2f\n", bank[i].accountNumber, bank[i].name, bank[i].balance);
    }
    printf("=========================================\n");
}


int findAccountIndex(int accNum) {
    for (int i = 0; i < totalAccounts; i++) {
        if (bank[i].accountNumber == accNum) {
            return i;
        }
    }
    return -1; 
}

