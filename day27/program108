#include <stdio.h>
#include <string.h>

#define NUM_SUBJECTS 5


struct Student {
    char name[50];
    int rollNumber;
    int marks[NUM_SUBJECTS];
    int totalMarks;
    float percentage;
    char grade;
};


char calculateGrade(float percentage) {
    if (percentage >= 85.0) return 'A';
    if (percentage >= 70.0) return 'B';
    if (percentage >= 50.0) return 'C';
    if (percentage >= 33.0) return 'D';
    return 'F';
}

int main() {
    struct Student student;
    const char *subjects[NUM_SUBJECTS] = {"Mathematics", "Physics", "Chemistry", "English", "Computer Sci"};
    student.totalMarks = 0;

    printf("=============================================\n");
    printf("     MARKSHEET GENERATION SYSTEM INPUT       \n");
    printf("=============================================\n");

 
    printf("Enter Student Full Name: ");
    fgets(student.name, sizeof(student.name), stdin);
    student.name[strcspn(student.name, "\n")] = '\0'; // Remove trailing newline character

    printf("Enter Roll Number: ");
    scanf("%d", &student.rollNumber);

  
    printf("\nEnter marks obtained out of 100:\n");
    for (int i = 0; i < NUM_SUBJECTS; i++) {
        while (1) {
            printf("  %-15s: ", subjects[i]);
            scanf("%d", &student.marks[i]);

           
            if (student.marks[i] >= 0 && student.marks[i] <= 100) {
                student.totalMarks += student.marks[i];
                break;
            }
            printf("  [Error] Marks must be between 0 and 100. Try again.\n");
        }
    }

   
    student.percentage = (float)student.totalMarks / NUM_SUBJECTS;
    student.grade = calculateGrade(student.percentage);

    // 4. Print the Formatted Marksheet
    printf("\n\n");
    printf("====================================================\n");
    printf("                SCHOLASTIC REPORT CARD              \n");
    printf("====================================================\n");
    printf(" Student Name : %-25s \n", student.name);
    printf(" Roll Number  : %-25d \n", student.rollNumber);
    printf("----------------------------------------------------\n");
    printf(" %-20s | %-12s | %-12s \n", "SUBJECT", "MAX MARKS", "MARKS OBTAINED");
    printf("----------------------------------------------------\n");
    
    for (int i = 0; i < NUM_SUBJECTS; i++) {
        printf(" %-20s | %-12d | %-12d \n", subjects[i], 100, student.marks[i]);
    }
    
    printf("----------------------------------------------------\n");
    printf(" SUMMARY METRICS:\n");
    printf("  - Total Marks Achieved : %d / %d\n", student.totalMarks, NUM_SUBJECTS * 100);
    printf("  - Final Percentage    : %.2f%%\n", student.percentage);
    printf("  - Overall Class Grade : %c\n", student.grade);
    printf("====================================================\n");
    printf("       Result Status: %s       \n", (student.grade == 'F') ? "FAILED" : "PASSED");
    printf("====================================================\n");

    return 0;
}
