#include <stdio.h>

int main() {
    int age;

   
    printf("Enter your age: ");
    scanf("%d", &age);

   
    if (age < 0 || age > 120) {
        printf("Invalid age entered. Please enter a valid age between 0 and 120.\n");
    } 
   
    else if (age >= 18) {
        printf("Congratulations! You are eligible to vote.\n");
    } else {
        printf("Sorry, you are not eligible to vote yet. You must be 18 or older.\n");
    }

    return 0;
}
