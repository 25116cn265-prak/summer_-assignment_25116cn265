#include <stdio.h>

int main() {
    int s1, s2, i;

    printf("Enter sizes of two arrays: ");
    scanf("%d %d", &s1, &s2);
    
    int a1[s1], a2[s2], m[s1 + s2];

    printf("Enter elements for array 1: ");
    for (i = 0; i < s1; i++) scanf("%d", &a1[i]);
    printf("Enter elements for array 2: ");
    for (i = 0; i < s2; i++) scanf("%d", &a2[i]);

    // Copying elements into new array
    for (i = 0; i < s1; i++) m[i] = a1[i];
    for (i = 0; i < s2; i++) m[s1 + i] = a2[i];

    printf("Merged array: ");
    for (i = 0; i < s1 + s2; i++) printf("%d ", m[i]);
    
    return 0;
}
