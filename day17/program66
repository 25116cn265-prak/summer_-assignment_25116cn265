#include <stdio.h>

// Function to find and print the union of two arrays
void printUnion(int arr1[], int size1, int arr2[], int size2) {
    // Maximum possible elements in the union array is the sum of both sizes
    int unionArr[size1 + size2];
    int unionSize = 0;

    // 1. Copy unique elements from the first array to unionArr
    for (int i = 0; i < size1; i++) {
        int isDuplicate = 0;
        
        // Check if the element is already added to unionArr
        for (int j = 0; j < unionSize; j++) {
            if (unionArr[j] == arr1[i]) {
                isDuplicate = 1;
                break;
            }
        }
        
        // If it is not a duplicate, add it
        if (!isDuplicate) {
            unionArr[unionSize] = arr1[i];
            unionSize++;
        }
    }

    // 2. Copy unique elements from the second array to unionArr
    for (int i = 0; i < size2; i++) {
        int isDuplicate = 0;
        
        // Check if the element is already added to unionArr
        for (int j = 0; j < unionSize; j++) {
            if (unionArr[j] == arr2[i]) {
                isDuplicate = 1;
                break;
            }
        }
        
        // If it is not a duplicate, add it
        if (!isDuplicate) {
            unionArr[unionSize] = arr2[i];
            unionSize++;
        }
    }

    // 3. Print the final union array
    printf("Union of the two arrays: ");
    for (int i = 0; i < unionSize; i++) {
        printf("%d ", unionArr[i]);
    }
    printf("\n");
}

int main() {
    // Example test arrays containing duplicate values
    int arr1[] = {1, 2, 3, 2, 1};
    int arr2[] = {3, 2, 5, 6, 3};
    
    // Dynamically calculate the sizes of the arrays
    int size1 = sizeof(arr1) / sizeof(arr1[0]);
    int size2 = sizeof(arr2) / sizeof(arr2[0]);

    printf("Array 1: ");
    for(int i = 0; i < size1; i++) printf("%d ", arr1[i]);
    printf("\n");

    printf("Array 2: ");
    for(int i = 0; i < size2; i++) printf("%d ", arr2[i]);
    printf("\n\n");

    // Call function to find and print the union
    printUnion(arr1, size1, arr2, size2);

    return 0;
}
